pub fn pid_str() -> string is return ft::text::istr(ft::sys::pid()) end

;; Ścieżka bezpieczna do rm -rf: bezwzględna, głębokość >= 2, bez "..", bez znaków sterujących powłoki.
pub fn safe_cache_path(p: string) -> bool is
    if !pure::starts_with(p, "/") || p.len() < 5 || pure::find(p, "..") >= 0 is return false end
    let mut i: int = 0
    while i < p.len() is
        let c: string = p[i..i + 1]
        let ok: bool = (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == "/" || c == "." || c == "_" || c == "-"
        if !ok is return false end
        i += 1
    end
    return pure::find(p[1..p.len()], "/") >= 0
end

pub fn clear_dir(p: string) -> string is
    if !safe_cache_path(p) is return "niebezpieczna ścieżka cache: '" + p + "'" end
    return meta::run("find " + ft::sys::sq(p) + " -mindepth 1 -delete")
end

pub fn remove_file(p: string) is
    let e: string = meta::run("rm -f -- " + ft::sys::sq(p))
end

pub fn make_dir(p: string) -> string is return meta::run("mkdir -p -- " + ft::sys::sq(p)) end
