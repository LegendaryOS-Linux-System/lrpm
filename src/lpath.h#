mod pure

;; lpath — czysta logika lpm (BEZ I/O, BEZ bibliotek bit; testowalna): mapowanie ścieżek RPM → układ
;; LegendaryOS oraz porządek instalacji pakietów (DAG; cykle RPM są przecinane i raportowane).
;; Przeniesione z lpm/src/plan.h# (tam została tylko operacja na plikach `remap_tree`) — dzięki temu
;; lpm nie potrzebuje własnych kopii pomocników tekstowych libfasttree, a testy nie ciągną bibliotek (N4).

;; Ścieżka z RPM (względna) -> ścieżka w obrazie. "" = nie trafia do niezmiennego obrazu.
pub fn map_path(rel: string) -> string is
    let n: int = rel.len()
    if n == 0 is return "" end
    let mut p: string = rel
    if pure::starts_with(p, "./") is p = p[2..n] end
    if pure::starts_with(p, "usr/") is return "system/" + p[4..p.len()] end
    if p == "usr" is return "system" end
    if pure::starts_with(p, "etc/") is return "system/etc/" + p[4..p.len()] end
    if p == "etc" is return "system/etc" end
    let tops: [string] = ["bin", "sbin", "lib", "lib64", "opt"]
    let mut i: int = 0
    while i < tops.len() is
        if p == tops[i] || pure::starts_with(p, tops[i] + "/") is return "system/" + p end
        i += 1
    end
    return ""
end

pub fn is_state_path(rel: string) -> bool is
    let tops: [string] = ["var", "home", "root", "srv", "run", "tmp", "mnt", "media"]
    let mut i: int = 0
    while i < tops.len() is
        if rel == tops[i] || pure::starts_with(rel, tops[i] + "/") is return true end
        i += 1
    end
    return false
end

pub struct Node is
    pub name:     string
    pub requires: [string]
    pub provides: [string]
end

;; Konstruktor (aplikacje nie tworzą literałów struktur z biblioteki — N2).
pub fn node(name: string, requires: [string], provides: [string]) -> Node is
    return Node { name: name, requires: requires, provides: provides }
end

pub fn req_name(r: string) -> string is
    let t: string = pure::trim(r)
    let sp: int = pure::find(t, " ")
    if sp < 0 is return t end
    return t[0..sp]
end

fn provides_name(n: Node, want: string) -> bool is
    if n.name == want is return true end
    let mut i: int = 0
    while i < n.provides.len() is
        if req_name(n.provides[i]) == want is return true end
        i += 1
    end
    return false
end

;; Indeksy węzłów, od których zależy węzeł `idx` (tylko wewnątrz zbioru).
pub fn deps_of(nodes: [Node], idx: int) -> [int] is
    let mut out: [int] = []
    let me: Node = nodes[idx]
    let mut r: int = 0
    while r < me.requires.len() is
        let want: string = req_name(me.requires[r])
        r += 1
        if want != "" && !pure::starts_with(want, "rpmlib(") is
            let mut j: int = 0
            while j < nodes.len() is
                if j != idx && provides_name(nodes[j], want) is
                    let mut seen: bool = false
                    let mut k: int = 0
                    while k < out.len() is
                        if out[k] == j is seen = true end
                        k += 1
                    end
                    if !seen is out.push(j) end
                end
                j += 1
            end
        end
    end
    return out
end

pub struct Order is
    pub order:  [int]
    pub broken: [string]
end

;; Porządek topologiczny (zależności przed zależnymi); krawędź wsteczna cyklu jest pomijana i raportowana.
pub fn order(nodes: [Node]) -> Order is
    let n: int = nodes.len()
    let mut state: [int] = []
    let mut i: int = 0
    while i < n is
        state.push(0)
        i += 1
    end
    let mut out: [int] = []
    let mut broken: [string] = []
    let mut root: int = 0
    while root < n is
        if state[root] == 0 is
            let mut stack: [int] = [root]
            let mut pos: [int] = [0]
            state[root] = 1
            while stack.len() > 0 is
                let top: int = stack.len() - 1
                let v: int = stack[top]
                let ds: [int] = deps_of(nodes, v)
                if pos[top] < ds.len() is
                    let w: int = ds[pos[top]]
                    pos[top] = pos[top] + 1
                    if state[w] == 0 is
                        state[w] = 1
                        stack.push(w)
                        pos.push(0)
                    else is
                        if state[w] == 1 is broken.push(nodes[v].name + " -> " + nodes[w].name) end
                    end
                else is
                    state[v] = 2
                    out.push(v)
                    let mut ns: [int] = []
                    let mut np: [int] = []
                    let mut k: int = 0
                    while k < top is
                        ns.push(stack[k])
                        np.push(pos[k])
                        k += 1
                    end
                    stack = ns
                    pos = np
                end
            end
        end
        root += 1
    end
    return Order { order: out, broken: broken }
end


;; Fasada na typach prostych dla `order`: indeksy w kolejności instalacji.
pub fn order_indices(nodes: [Node]) -> [int] is return order(nodes).order end
pub fn order_broken(nodes: [Node]) -> [string] is return order(nodes).broken end
