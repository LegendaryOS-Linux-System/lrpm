[package]
-> name        => lrpm
-> version     => 0.1.0
-> description => Wspólny silnik RPM dla lpm i lepm: rpm-md → satsolv (libsolv) → pobranie/weryfikacja → rozpakowanie. Bez dnf.
-> authors     => ["LegendaryOS Team"]
-> license     => GPL-3.0
-> lang        => h#

[edition]
-> edition => 2026

[layout]
-> src => src

[lib]
-> output => hlib

[commands]
-> test
--> run => scripts/run-tests.sh
--> description => Testy czystej logiki: pure + lpath (bez bibliotek bit — N4)

[dependencies]
-> libfasttree => newest
-> satsolv => newest
